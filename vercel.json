{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.agentbox.ac" }],
      "destination": "https://agentbox.ac/:path*",
      "permanent": true
    },
    {
      "source": "/download",
      "destination": "https://github.com/agentboxhq/agentbox-releases/releases/latest/download/Agentbox.dmg",
      "permanent": false
    }
  ]
}
